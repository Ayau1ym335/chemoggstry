{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/experiment.schema.json",
  "title": "Experiment Point",
  "description": "Схема для точки эксперимента",
  "type": "object",
  "properties": {
    "reactionId": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "minimum": 0
    },
    "concentration": {
      "type": "number",
      "minimum": 0
    },
    "catalyst": {
      "type": "string"
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "yield": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "timeToOptimum": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "reactionId",
    "temperature",
    "concentration",
    "catalyst",
    "time",
    "yield"
  ],
  "additionalProperties": false
}
