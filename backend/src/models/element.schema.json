{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Element",
  "description": "Schema for chemical elements. Note: group and period must correspond exactly to the standard periodic table layout, not an arbitrary UI grid.",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "maxLength": 3
    },
    "name": {
      "type": "string"
    },
    "atomicNumber": {
      "type": "integer",
      "minimum": 1
    },
    "group": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "period": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "category": {
      "type": "string",
      "enum": ["metal", "non-metal", "metalloid", "noble-gas"]
    },
    "shortDescription": {
      "type": "string",
      "description": "1-2 sentences for ElementInfoPanel"
    }
  },
  "required": ["symbol", "name", "atomicNumber", "group", "period", "category", "shortDescription"]
}
